{
  "name": "@dcasegr/skein",
  "version": "0.2.0",
  "description": "A deterministic WASI machine over a content-addressed graph: the node host (it loads the wasm kernel, kernel-zig built for the web target), the client, its peers, and dev tools.",
  "type": "module",
  "bin": {
    "skein": "./bin/skein.js",
    "skein-host": "./bin/skein-host.js"
  },
  "scripts": {
    "skein": "bin/skein",
    "skein-dev": "bin/skein-dev",
    "test": "node --experimental-strip-types --no-warnings --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "web:build": "node --experimental-strip-types --no-warnings web/build.ts",
    "web:serve": "scripts/host/web.sh",
    "web:test": "node --experimental-strip-types --no-warnings --test 'web/*.test.ts'",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "build:kernel": "cd kernel-zig && zig build web",
    "prepack": "npm run build && npm run build:kernel"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@1sat/templates": "^0.0.43",
    "@1sat/utils": "^0.0.42",
    "@1sat/wallet-browser": "^0.0.102",
    "@bsv/message-box-client": "^2.5.4",
    "@bsv/sdk": "^2.8.6",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@ipld/dag-cbor": "^10.0.2",
    "@ipld/dag-json": "^11.0.1",
    "@libp2p/circuit-relay-v2": "4.2.13",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/gossipsub": "17.1.2",
    "@libp2p/identify": "4.1.14",
    "@libp2p/kad-dht": "16.4.5",
    "@libp2p/mdns": "12.0.32",
    "@libp2p/peer-id": "6.0.15",
    "@libp2p/ping": "3.1.13",
    "@libp2p/tcp": "11.0.28",
    "@libp2p/utils": "7.4.1",
    "@libp2p/websockets": "10.1.21",
    "@multiformats/multiaddr": "13.0.3",
    "libp2p": "3.3.11",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@1sat/connect": "^0.0.101",
    "@types/node": "^26.6.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "bin/skein.js",
    "bin/skein-host.js",
    "kernel-zig/web/kernel.js",
    "kernel-zig/web/kernel.d.ts",
    "kernel-zig/web/store.js",
    "kernel-zig/web/worker.js",
    "kernel-zig/web/client.js",
    "kernel-zig/zig-out/web/skein-kernel.wasm",
    "wasm/*.wasm",
    "images",
    "README.md"
  ],
  "optionalDependencies": {
    "lmdb": "3.5.7"
  },
  "engines": {
    "node": ">=24"
  }
}
