{
  "name": "@amm-poc/market-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LP and taker pages for the AMM PoC, served as static content from a skein overlay instance's HTTP routes. See README.md.",
  "scripts": {
