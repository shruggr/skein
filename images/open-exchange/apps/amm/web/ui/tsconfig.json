{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "runar-sdk": [
        "../../../../bsv/runar/packages/runar-sdk/src/index.ts"
      ],
      "runar-ir-schema": [
        "./src/pool/runar-ir-schema.ts"
      ],
      "@runar-src/*": [
        "../../../../bsv/runar/packages/*"
      ],
      "@1sat/templates/mandala": [
        "../../../../bsv/1sat-sdk/packages/templates/src/mandala/mandala.ts"
      ],
      "cbor2": [
        "./node_modules/cbor2/lib/index.d.ts"
      ],
      "cbor2/*": [
        "./node_modules/cbor2/lib/*.d.ts"
      ],
      "@bsv/sdk": [
        "./node_modules/@bsv/sdk/dist/types/mod.d.ts"
      ],
      "@bsv/sdk/*": [
        "./node_modules/@bsv/sdk/dist/types/src/*.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ]
}
