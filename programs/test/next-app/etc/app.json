{
  "kind": "app",
  "name": "next",
  "version": "0.1.0",
  "description": "The host's test app: the kernel's test program (kernel-zig/test/call/next.zig, its next.wasm copied here) as an app \u2014 checks pass, reject, store, principal, unspent; a read; a handler that answers, awaits a fact, emits one.",
  "programs": {
    "main": "bin/next.wasm"
  },
  "roles": {
    "admin": "the test's own role (granted by root)"
  },
  "routes": [
    {
      "kind": "request",
      "path": "/next/user",
      "role": "user",
      "handler": "next.main.handle"
    },
    {
      "kind": "request",
      "path": "/next/root",
      "role": "root",
      "handler": "next.main.handle"
    },
    {
      "kind": "request",
      "path": "/next/admin",
      "role": "next.admin",
      "handler": "next.main.handle"
    },
    {
      "kind": "request",
      "path": "/next/proven",
      "role": "anyone",
      "checks": [
        "next.main.pass"
      ],
      "handler": "next.main.handle"
    },
    {
      "kind": "request",
      "path": "/next/refused",
      "role": "anyone",
      "checks": [
        "next.main.pass",
        "next.main.reject"
      ],
      "handler": "next.main.handle"
    },
    {
      "kind": "request",
      "path": "/next/vouched",
      "role": "anyone",
      "checks": [
        "next.main.principal"
      ],
      "handler": "next.main.handle"
    },
    {
      "kind": "read",
      "path": "/next/read/",
      "prefix": true,
      "role": "anyone",
      "handler": "next.main.read"
    },
    {
      "kind": "request",
      "path": "/next/awaitname",
      "role": "user",
      "handler": "next.main.awaitname"
    },
    {
      "kind": "event",
      "name": "next/event",
      "handler": "next.main.event"
    }
  ]
}
