{
  "kind": "app",
  "name": "app-demo",
  "version": "0.1.0",
  "programs": {
    "demo": "bin/app-demo.wasm"
  },
  "provides": [
    {
      "interface": "demo.counter/1",
      "functions": {
        "get": {
          "writes": false,
          "args": {},
          "answer": {
            "count": "int"
          }
        },
        "add": {
          "writes": true,
          "args": {
            "by": "int",
            "note?": "string"
          },
          "answer": {
            "count": "int"
          }
        },
        "peek": {
          "writes": false,
          "args": {},
          "answer": {
            "count": "int"
          }
        }
      }
    }
  ],
  "requires": [],
  "start": {
    "body": {
      "kind": "app-demo-start"
    }
  },
  "stop": {
    "body": {
      "kind": "app-demo-stop"
    }
  },
  "description": "A counter (skein's test app for install, #72/#76/#77): demo.counter/1 over its head's state (app-demo/app), a heartbeat from the cron provider scheduled by its start message.",
  "routes": [
    {
      "address": "",
      "handler": "demo"
    },
    {
      "address": "tick",
      "handler": "demo"
    },
    {
      "transport": "http",
      "address": "/call",
      "filters": [
        "kernel.brc104"
      ],
      "handler": "demo.call"
    }
  ]
}
