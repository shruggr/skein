@@ -0,0 +1,62 @@
+//! Host process spawn for running `xargs` under the skein WASI host (import
+//! module "skein"). WASI preview1 has no `fork`/`exec`; the host runs a
+//! registered program to completion, synchronously, with its stdio bound to
+//! fds of this instance. See `wasm/README.md` (brush's `sys/wasm/skein.rs`,
+//! which this mirrors) for the wire format.
+
+use std::ffi::{OsStr, OsString};
+use std::io;
+
+#[link(wasm_import_module = "skein")]
+unsafe extern "C" {
+    #[link_name = "spawn"]
+    fn host_spawn(req: *const u8, len: usize, stdin: i32, stdout: i32, stderr: i32, code: *mut i32) -> i32;
+}
+
+fn errno(e: i32) -> io::Error {
+    match e {
+        44 => io::Error::from(io::ErrorKind::NotFound), // ENOENT
+        _ => io::Error::other(format!("skein host error {e}")),
+    }
+}
+
+fn push(buf: &mut Vec<u8>, s: &[u8]) {
+    buf.extend_from_slice(s);
+    buf.push(0);
+}
+
+/// Runs `program` (argv[0] = program, then `args`), with `env` as its whole
+/// environment, to completion, inheriting this process's stdout/stderr (or
+/// /dev/null on stdin when `close_stdin`). Returns its exit code.
+pub fn spawn<'a>(
+    program: &OsStr,
+    args: &[OsString],
+    env: impl Iterator<Item = (&'a OsStr, &'a OsStr)>,
+    close_stdin: bool,
+) -> io::Result<i32> {
+    use std::os::wasi::ffi::OsStrExt as _;
+    let mut req = Vec::new();
+    push(&mut req, program.as_bytes());
+    push(&mut req, b""); // cwd: inherit (this process's $PWD already applies)
+    push(&mut req, (args.len() + 1).to_string().as_bytes());
+    push(&mut req, program.as_bytes());
+    for a in args {
+        push(&mut req, a.as_bytes());
+    }
+    let env: Vec<(&OsStr, &OsStr)> = env.collect();
+    push(&mut req, env.len().to_string().as_bytes());
+    for (k, v) in &env {
+        let mut kv = k.as_bytes().to_vec();
+        kv.push(b'=');
+        kv.extend_from_slice(v.as_bytes());
+        push(&mut req, &kv);
+    }
+    let mut code = 0i32;
+    let stdin = if close_stdin { -1 } else { 0 };
+    // SAFETY: req and code are live for the call.
+    let e = unsafe { host_spawn(req.as_ptr(), req.len(), stdin, 1, 2, &raw mut code) };
+    if e != 0 {
+        return Err(errno(e));
+    }
+    Ok(code)
+}
