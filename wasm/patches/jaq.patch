+
+# rustyline (the `repl` builtin) needs a real terminal (termios/ioctl) that
+# WASI preview1 does not have; skein's shell has no interactive terminal
+# either, so the wasm build drops it (funs.rs stubs `repl` there instead).
+[target.'cfg(not(target_os = "wasi"))'.dependencies]
+dirs = { version = "6.0" }
+rustyline = { version = "13.0.0", default-features = false, features = ["with-file-history"] }
