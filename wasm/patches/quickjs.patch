diff --git i/qjs.c w/qjs.c
index 9653391..5c43bac 100644
--- i/qjs.c
+++ w/qjs.c
@@ -35,6 +35,11 @@
 #include "cutils.h"
 #include "quickjs.h"
 #include "quickjs-libc.h"
+#ifdef SKEIN_PRELUDE
+/* skein (wasm/tools/qjs): console methods for every run; the `node` shim when
+   started under the name `node`. Generated by wasm/tools/qjs/gen-prelude.mjs. */
+#include "skein-prelude.h"
+#endif
 
 #ifdef QJS_USE_MIMALLOC
 #include <mimalloc.h>
@@ -428,6 +433,9 @@ int main(int argc, char **argv)
     int empty_run = 0;
     int module = -1;
     int load_std = 0;
+#ifdef SKEIN_PRELUDE
+    int skein_node = 0, skein_exit = 0;
+#endif
     char *include_list[32];
     int i, include_count = 0;
     int64_t memory_limit = -1;
@@ -655,6 +663,22 @@ start:
             eval_buf(ctx, str, strlen(str), "<input>", JS_EVAL_TYPE_MODULE);
         }
 
+#ifdef SKEIN_PRELUDE
+        {
+            const char *base = strrchr(argv[0], '/');
+            base = base ? base + 1 : argv[0];
+            skein_node = !strcmp(base, "node");
+            for (i = 0; i < countof(skein_prelude); i++)
+                if (eval_buf(ctx, skein_prelude[i].src, strlen(skein_prelude[i].src),
+                             skein_prelude[i].name, JS_EVAL_TYPE_MODULE))
+                    goto fail;
+            for (i = 0; skein_node && i < countof(skein_node_modules); i++)
+                if (eval_buf(ctx, skein_node_modules[i].src, strlen(skein_node_modules[i].src),
+                             skein_node_modules[i].name, JS_EVAL_TYPE_MODULE))
+                    goto fail;
+        }
+#endif
+
         for(i = 0; i < include_count; i++) {
             if (eval_file(ctx, include_list[i], 0))
                 goto fail;
@@ -718,6 +742,25 @@ start:
             js_std_dump_error(ctx);
             goto fail;
         }
+#ifdef SKEIN_PRELUDE
+        /* node: process.exitCode is the exit status once the loop drains */
+        if (skein_node) {
+            JSValue g = JS_GetGlobalObject(ctx);
+            JSValue f = JS_GetPropertyStr(ctx, g, "__skeinExitCode");
+            JSValue v = JS_Call(ctx, f, g, 0, NULL);
+            int32_t code = 0;
+            if (JS_IsException(v)) {
+                js_std_dump_error(ctx);
+                code = 1;
+            } else if (JS_IsNumber(v)) {
+                JS_ToInt32(ctx, &code, v);
+            }
+            JS_FreeValue(ctx, v);
+            JS_FreeValue(ctx, f);
+            JS_FreeValue(ctx, g);
+            skein_exit = code;
+        }
+#endif
     }
 
     if (dump_memory) {
@@ -753,7 +796,11 @@ start:
                best[1] + best[2] + best[3] + best[4],
                best[1], best[2], best[3], best[4]);
     }
+#ifdef SKEIN_PRELUDE
+    return skein_exit;
+#else
     return 0;
+#endif
  fail:
     js_std_free_handlers(rt);
     JS_FreeContext(ctx);
diff --git i/quickjs.c w/quickjs.c
index 6ca030b..ec23bb1 100644
--- i/quickjs.c
+++ w/quickjs.c
@@ -32,6 +32,9 @@
 #include <assert.h>
 #if !defined(_MSC_VER)
 #include <sys/time.h>
+#if defined(__wasi__) && defined(SKEIN_PRELUDE)
+#include <sys/random.h>
+#endif
 #if defined(_WIN32)
 #include <timezoneapi.h>
 #endif
@@ -2876,7 +2879,14 @@ JSContext *JS_NewContextRaw(JSRuntime *rt)
     ctx->error_stack_trace_limit = js_int32(10);
     init_list_head(&ctx->loaded_modules);
     // TODO(bnoordhuis) use getrandom() etc.
+#if defined(__wasi__) && defined(SKEIN_PRELUDE)
+    // skein: seed Math.random from the runtime's random stream (random_get),
+    // like every other program's randomness, not from the clock
+    if (getentropy(&ctx->random_state, sizeof(ctx->random_state)) != 0)
+        ctx->random_state = js__gettimeofday_us();
+#else
     ctx->random_state = js__gettimeofday_us();
+#endif
     // the state must be non zero
     if (ctx->random_state == 0)
         ctx->random_state = 1;
