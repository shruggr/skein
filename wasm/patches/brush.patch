 //! Main entry for the `brush` shell.
 
 fn main() {
+    // WASI has no inherited working directory: wasi-libc starts every program at "/".
+    // The skein host passes the directory in $PWD, as a shell does.
+    #[cfg(target_os = "wasi")]
+    if let Some(pwd) = std::env::var_os("PWD") {
+        let _ = std::env::set_current_dir(pwd);
+    }
     brush_shell::entry::run();
 }
