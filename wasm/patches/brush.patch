diff --git i/brush-core/src/sys/wasm/skein.rs w/brush-core/src/sys/wasm/skein.rs
new file mode 100644
index 00000000..d3f29614
--- /dev/null
+++ w/brush-core/src/sys/wasm/skein.rs
@@ -0,0 +1,93 @@
+//! Host services for running under the skein WASI host (import module "skein").
+//!
+//! WASI preview1 has no process spawning and no anonymous pipes. The skein host
+//! provides both: `pipe` creates a buffered in-host pipe (two fds in this
+//! instance's fd table) and `spawn` runs a registered program to completion,
+//! synchronously, as a separate WASI instance over the same filesystem, with
+//! its stdio bound to fds of this instance. Because every child runs to
+//! completion before `spawn` returns, pipelines execute stage by stage and a
+//! read from an empty pipe is end-of-file.
+
+use std::ffi::OsStr;
+use std::io;
+use std::os::fd::FromRawFd as _;
+use std::path::Path;
+
+#[link(wasm_import_module = "skein")]
+unsafe extern "C" {
+    #[link_name = "cmd_exists"]
+    fn host_cmd_exists(name: *const u8, len: usize) -> i32;
+    #[link_name = "pipe"]
+    fn host_pipe(fds: *mut u32) -> i32;
+    #[link_name = "spawn"]
+    fn host_spawn(req: *const u8, len: usize, stdin: i32, stdout: i32, stderr: i32, code: *mut i32) -> i32;
+}
+
+fn errno(e: i32) -> io::Error {
+    match e {
+        44 => io::Error::from(io::ErrorKind::NotFound), // ENOENT
+        _ => io::Error::other(format!("skein host error {e}")),
+    }
+}
+
+/// Whether the host has a program registered under this bare name.
+pub fn command_exists(name: &str) -> bool {
+    // SAFETY: pointer/len describe a live byte slice.
+    unsafe { host_cmd_exists(name.as_ptr(), name.len()) == 1 }
+}
+
+/// An in-host pipe: (read end, write end).
+pub fn pipe() -> io::Result<(std::fs::File, std::fs::File)> {
+    let mut fds = [0u32; 2];
+    // SAFETY: fds has room for two u32s.
+    let e = unsafe { host_pipe(fds.as_mut_ptr()) };
+    if e != 0 {
+        return Err(errno(e));
+    }
+    // SAFETY: the host just opened these fds for us and nothing else owns them.
+    #[allow(clippy::cast_possible_wrap)]
+    unsafe {
+        Ok((
+            std::fs::File::from_raw_fd(fds[0] as i32),
+            std::fs::File::from_raw_fd(fds[1] as i32),
+        ))
+    }
+}
+
+fn push(buf: &mut Vec<u8>, s: &[u8]) {
+    buf.extend_from_slice(s);
+    buf.push(0);
+}
+
+/// Runs `program` to completion; returns its exit code. Fds of -1 mean "none" (/dev/null).
+pub fn spawn(
+    program: &OsStr,
+    cwd: Option<&Path>,
+    args: &[&OsStr],
+    env: &[(&OsStr, &OsStr)],
+    stdio: [i32; 3],
+) -> io::Result<i32> {
+    use std::os::wasi::ffi::OsStrExt as _;
+    // Request: NUL-terminated fields: program, cwd, argc, args..., envc, KEY=VAL...
+    let mut req = Vec::new();
+    push(&mut req, program.as_bytes());
+    push(&mut req, cwd.map(|p| p.as_os_str().as_bytes()).unwrap_or_default());
+    push(&mut req, args.len().to_string().as_bytes());
+    for a in args {
+        push(&mut req, a.as_bytes());
+    }
+    push(&mut req, env.len().to_string().as_bytes());
+    for (k, v) in env {
+        let mut kv = k.as_bytes().to_vec();
+        kv.push(b'=');
+        kv.extend_from_slice(v.as_bytes());
+        push(&mut req, &kv);
+    }
+    let mut code = 0i32;
+    // SAFETY: req and code are live for the call.
+    let e = unsafe { host_spawn(req.as_ptr(), req.len(), stdio[0], stdio[1], stdio[2], &raw mut code) };
+    if e != 0 {
+        return Err(errno(e));
+    }
+    Ok(code)
+}
