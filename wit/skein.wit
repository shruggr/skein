/// The skein machine's own calls for handler programs, as WIT (issue #34).
///
/// The same calls, with the same behaviour, as the preview1 `skein` import
/// namespace (src/runtime/wasi/skein-imports.ts, kernel-zig/src/program.zig).
/// The only difference is the ABI:
///
/// - preview1 returns bytes through `f(…, out, cap) → n` with `take(out, cap)`
///   for a result that did not fit; here the canonical ABI hands the guest the
///   whole result (its `cabi_realloc`), so there is no `take` and no `cap`.
/// - preview1 signals failure with `n < 0` and the message from
///   `error(out, cap)`; here a call that can fail returns `result<_, string>`
///   whose error is that same message. A host error that is not the
///   program's business (a diverged replay, a missing witness, the step's fuel
///   running out) ends the run as it does under preview1: the call traps.
/// - CIDs are binary, as under preview1 (`list<u8>`). Names are `string`
///   (preview1 decoded them as UTF-8 with replacement; here the canonical ABI
///   requires valid UTF-8).
package skein:kernel@0.1.0;

interface skein {
  /// A CID in its binary form.
  type cid = list<u8>;

  /// The step's input record (dag-cbor).
  input: func() -> list<u8>;

  /// A record's bytes.
  get: func(cid: cid) -> result<list<u8>, string>;

  /// Store dag-cbor (re-encoded canonically); its CID.
  put: func(data: list<u8>) -> result<cid, string>;

  /// Store bytes under a CID minted elsewhere; the hash is checked. Besides
  /// dag-cbor/raw with sha2-256, `bitcoin-tx` and `bitcoin-block` with
  /// dbl-sha2-256 (#29).
  putblock: func(cid: cid, data: list<u8>) -> result<_, string>;

  /// Keep a stored record in the thread's state: listed in this step's update
  /// (`kept`), so later steps find it from the tip.
  keep: func(cid: cid) -> result<_, string>;

  /// Open a thread running `program` (a program record) on `args` (a record);
  /// its origin CID.
  launch: func(program: cid, args: cid) -> result<cid, string>;

  /// Rest on a record in the store (the step ends `waiting` with `awaits`):
  /// a message this step sent (#40: the record the messagebox's `send` put —
  /// an admitted message whose body's `replyTo` names it, from the identity it
  /// was sent to, is the thread's next input), or the subject of a plain entry
  /// to come (#29).
  await: func(cid: cid) -> result<_, string>;

  /// The tree CID a named head points at; none if it has none (preview1:
  /// n = 0). docs/VM.md "Heads".
  head: func(name: string) -> result<option<cid>, string>;

  /// Move a named head to a tree in the store, when the step ends without error.
  advance: func(name: string, tree: cid) -> result<_, string>;

  /// Change the subscriptions (docs/VM.md "Subscriptions"): `op` "add" or
  /// "remove" the rule (sender, box) → handler (a program record in the
  /// store; no sender: any sender), when the step ends without error.
  subscribe: func(op: string, sender: option<string>, box: string, handler: cid) -> result<_, string>;

  /// A BRC-100 wallet wire request frame → its result frame. Attested.
  wallet: func(frame: list<u8>) -> result<list<u8>, string>;

  /// One HTTP request, dag-cbor {method, url, headers?, body?} → the response
  /// {status, headers, body}, answered by the host and recorded (op "http").
  /// The pre-#15 shape, kept for preview1 programs (their `skein.http`
  /// import); a component uses standard `wasi:http/outgoing-handler` (#15),
  /// which the kernel turns into this very request, answered and recorded by
  /// the same path.
  http: func(request: list<u8>) -> result<list<u8>, string>;

  /// If this step ends waiting, rest no later than `until-ms` (ms since the
  /// epoch, after the step's time): a wake entry then steps the thread (#29).
  deadline: func(until-ms: s64) -> result<_, string>;

  /// An in-VM call (#40): run `program` (a program record) as a function —
  /// its entry, with `input()` = {kind: "call", fn, arg, …} — and return what
  /// it wrote to stdout (a non-zero exit is the error, its last stderr line).
  /// From a step, the callee is part of the step (its recorded calls, records
  /// and head moves are the step's); from the kernel's `call`, it only reads.
  call: func(program: cid, fn: string, arg: list<u8>) -> result<list<u8>, string>;

  /// The edges into a record (#42): who points at `to`, from the kernel's
  /// index, `rel` only if given — dag-cbor [{from, seq, rel, locator}] in key
  /// order (from, seq, ord). Who spent txid:vout is `spends` into the
  /// transaction's CID with locator = vout (from each kept spending
  /// transaction, seq 0). A read, a pure function of the log plus the
  /// bitcoin blocks this step kept so far.
  edges: func(to: cid, rel: option<string>) -> result<list<u8>, string>;
}

/// libp2p from a step (#51): answered by the router's libp2p host (the runtime
/// has no network), each call **recorded on the update like `http`** — request
/// and result, as the dag-cbor request preview1's `skein.libp2p` import takes
/// (`{op: "publish" | "dial" | "send" | "receive" | "close", …}`), so replay
/// serves the recorded result and never touches the network, and a differing
/// request on replay is a divergence. A host failure (a dial that fails, a
/// stream that is gone) is recorded too, and is the call's error. Published
/// messages are signed by GossipSub with the instance's peer key (a child of
/// the host's master secret, key ID `libp2p:<handle>`), never a wallet key.
/// Refused in a kernel call (only a step sends) and in the browser build.
interface libp2p {
  /// What `receive` found on the stream.
  variant received {
    /// The next length-prefixed frame.
    frame(list<u8>),
    /// Nothing yet: set a `deadline` and end the step; the thread rests, and
    /// the router wakes it (a wake entry, before the deadline) when a frame
    /// arrives, so its next step's `receive` has it.
    pending,
    /// The remote closed the stream; nothing more will come.
    closed,
  }

  /// Publish `body` on a GossipSub topic (signed with the instance's peer
  /// key) → the message's seqno.
  publish: func(topic: string, body: list<u8>) -> result<u64, string>;

  /// Open a stream to a peer (a peer ID, or a multiaddr with /p2p/<id>) on
  /// `protocol` → its id (the router's, unique across its restarts).
  dial: func(peer: string, protocol: string) -> result<u64, string>;

  /// Write one length-prefixed frame (unsigned varint length).
  send: func(stream-id: u64, body: list<u8>) -> result<_, string>;

  /// The next frame, or `pending` (rest; woken when it comes), or `closed`.
  receive: func(stream-id: u64) -> result<received, string>;

  /// Close the stream (our side), and forget it.
  close: func(stream-id: u64) -> result<_, string>;
}

/// What a handler program imports beyond WASI's command world: skein's calls
/// and outgoing HTTP (`wasi:http`, #15). A program built for
/// preview1 WASI (Zig, C, Rust `wasm32-wasip1`) embeds this world with
/// wit-bindgen and becomes a component through the preview1 command adapter
/// (`wasm-tools component new --adapt`), which brings the WASI imports and
/// the `wasi:cli/run` export: the result targets `handler`.
world program {
  import skein;
  import libp2p;
  import wasi:http/outgoing-handler@0.2.12;
}

/// A handler program as a component: a WASI 0.2 command (`wasi:cli/run`) with
/// the standard worlds the kernel answers over the graph, plus skein's calls.
///
/// WASI 0.2.12 (the version wasmtime v49 ships and its preview1 adapter
/// imports). The kernel's answers (kernel-zig/src/component.zig):
/// - `wasi:filesystem`: the thread's tree (an empty one for a handler step),
///   exactly as preview1's path_* / fd_* over the same vfs;
/// - `wasi:clocks`: the entry's stamp (wall and monotonic);
/// - `wasi:random`: the entry-derived stream (insecure too);
/// - `wasi:cli`: args (argv[0] = the program's name), no environment,
///   stdin empty, stdout/stderr captured; no terminal.
/// - `wasi:http/outgoing-handler` (#15): each request is serialized into the
///   recorded-call shape of `skein.http` and answered by the host; request and
///   response are recorded on the step's update, so replay reads the answer
///   and never touches the network. Bodies are buffered; no trailers.
/// - `skein:kernel/libp2p` (#51): each call serialized into the recorded
///   request of preview1's `skein.libp2p` and answered by the router's libp2p
///   host; recorded on the update, so replay never touches the network.
/// No sockets, no incoming handler.
world handler {
  import wasi:cli/environment@0.2.12;
  import wasi:cli/exit@0.2.12;
  import wasi:io/error@0.2.12;
  import wasi:io/poll@0.2.12;
  import wasi:io/streams@0.2.12;
  import wasi:cli/stdin@0.2.12;
  import wasi:cli/stdout@0.2.12;
  import wasi:cli/stderr@0.2.12;
  import wasi:cli/terminal-input@0.2.12;
  import wasi:cli/terminal-output@0.2.12;
  import wasi:cli/terminal-stdin@0.2.12;
  import wasi:cli/terminal-stdout@0.2.12;
  import wasi:cli/terminal-stderr@0.2.12;
  import wasi:clocks/monotonic-clock@0.2.12;
  import wasi:clocks/wall-clock@0.2.12;
  import wasi:filesystem/types@0.2.12;
  import wasi:filesystem/preopens@0.2.12;
  import wasi:random/random@0.2.12;
  import wasi:random/insecure@0.2.12;
  import wasi:random/insecure-seed@0.2.12;
  import wasi:http/types@0.2.12;
  import wasi:http/outgoing-handler@0.2.12;
  import skein;
  import libp2p;

  export wasi:cli/run@0.2.12;
}
